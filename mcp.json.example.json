{
  "mcpServers": {
    "filesystem": {
      "command": "npx",
      "args": [
        "-y",
        "@modelcontextprotocol/server-filesystem@2026.1.14",
        "/Users/<you>/comp0000/lab03-workspace"
      ]
    },
    "github": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-github@2026.1.14"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "${env:GITHUB_TOKEN}"
      }
    },
    "student-records": {
      "command": "/location_of_your_Python/python.exe",
      "args": ["/Users/<you>/comp0000/lab03-workspace/mcp_template/server.py"]
    }
  }
}